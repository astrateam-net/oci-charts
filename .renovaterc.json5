{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>astrateam-net/renovate-config"],
  customManagers: [
    {
      customType: "regex",
      description: ["Process Helm-sourced charts"],
      managerFilePatterns: ["/(^|/)metadata\\.ya?ml$/"],
      matchStrings: [
        "artifactName:\\s+(?<artifactName>\\S+)\\s+source:\\s+helm:\\s+registry:\\s+(?<registryUrl>\\S+)\\s+version:\\s+(?<currentValue>\\S+)(?:\\s+chart:\\s+(?<chart>\\S+))?",
      ],
      datasourceTemplate: "helm",
      depNameTemplate: "{{#if chart}}{{chart}}{{else}}{{artifactName}}{{/if}}",
    },
    {
      customType: "regex",
      description: ["Process git-sourced charts"],
      managerFilePatterns: ["/(^|/)metadata\\.ya?ml$/"],
      matchStrings: [
        "source:\\s+git:\\s+repository:\\s+(?<depName>\\S+)\\s+path:\\s+\\S+\\s+tag:\\s+(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "git-tags",
      versioningTemplate: "semver-coerced",
    },
  ],
  packageRules: [
    {
      description: [
        "langchain-ai/helm tags every chart it holds with the chart name, so git-tags hands each of them the whole repository's tags.",
        "extractVersion keeps only this chart's tags and strips the prefix; semver-coerced would flatten every 0.17.0-rc.N to 0.17.0 and see no update at all.",
      ],
      matchFileNames: ["apps/langsmith/metadata.yaml"],
      extractVersion: "^langsmith-(?<version>\\d+\\..+)$",
      versioning: "semver",
      ignoreUnstable: false,
    },
    {
      matchFileNames: ["apps/langsmith-auth-proxy/metadata.yaml"],
      extractVersion: "^langsmith-auth-proxy-(?<version>\\d+\\..+)$",
      versioning: "semver",
    },
    {
      description: "Auto-merge mirrored charts",
      matchDatasources: ["helm", "git-tags"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["major", "minor", "patch"],
      ignoreTests: false,
    },
  ],
}
